projection;
strict ( 2 );

use draft;

define behavior for zsac_c_billheader_j //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _item { create; with draft; }
}

define behavior for zsac_c_bill_item_j
{
  use update;
  use delete;

 use association _header { with draft; }
}