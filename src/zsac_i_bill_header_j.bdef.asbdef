managed implementation in class zbp_sac_i_bill_header_j unique;
strict ( 2 );
with draft;

define behavior for ZSAC_I_BILL_HEADER_j //alias <alias_name>
persistent table zsac_bill_head_j
draft table zsac_dbillhead_j
lock master total etag LastChangeDat
authorization master ( instance, global )
etag master LocalLastChangeDat
{
  create ( precheck );
  update;
  delete;

  draft action Edit;
  draft action Resume;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;

  field ( readonly : update, mandatory : create ) BillId;

  //Action
  action updateBillingDate result [1] $self;

 // Validation definition
  validation validateAmount on save { field NetAmount; create; update; }


  association _item { create; with draft; }

  mapping for zsac_bill_head_j
    {
      BillId             = bill_id;
      BillType           = bill_type;
      BillDate           = bill_date;
      CustomerId         = customer_id;
      NetAmount          = net_amount;
      Currency           = currency;
      SalesOrg           = sales_org;
      CreatedBy          = created_by;
      CreateDat          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for ZSAC_I_BILL_ITEM_j
persistent table zsac_bill_item_j
draft table zsac_dbillitem_j
lock dependent by _header
authorization dependent by _header
{
  update;
  delete;

  field ( readonly : update, mandatory : create ) BillId, ItemNo;

  association _header { with draft; }

  mapping for zsac_bill_item_j
    {
      BillId             = bill_id;
      ItemNo             = item_no;
      MaterialId         = material_id;
      Description        = description;
      Quantity           = quantity;
      ItemAmount         = item_amount;
      Currency           = currency;
      Uom                = uom;
      CreatedBy          = created_by;
      CreateDat          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}